# react-scripts@5's dependency tree has multiple mutually-incompatible
# versions of ajv/ajv-keywords required by different webpack plugins
# (schema-utils@2 vs schema-utils@4). npm's default flat/hoisted install
# dedupes them onto a single (wrong) version and breaks the build with
# "Cannot find module 'ajv/dist/compile/codegen'". Nested install gives
# every package its own correctly-matched copy instead.
install-strategy=nested
